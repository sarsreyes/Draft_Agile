#!/bin/sh
# Require an issue reference (e.g. #12) in every commit message.
# Enable once per clone with:  git config core.hooksPath .githooks
msg_file="$1"
if grep -qE '#[0-9]+|^Merge ' "$msg_file"; then
  exit 0
fi
echo "ERROR: commit message must reference an issue, e.g. 'feat: add top reactions (#12)'"
exit 1
